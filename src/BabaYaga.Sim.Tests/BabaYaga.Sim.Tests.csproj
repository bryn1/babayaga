<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- M5-S5 (MC 11939): HUDCORE compiles ONLY the pure HudReadout core of the
         linked Hud.cs beside these tests (the S3/S4 purity idiom, kept inside
         one file because the S5 ownership row pins the HUD to Hud.cs); the
         Godot shell stays engine-side, no engine process, no engine reference. -->
    <DefineConstants>$(DefineConstants);HUDCORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The skeleton-wave data gate lives at repo-root tests/ (beside the pytest
         seeds) and rides this project's compilation, so dotnet test BabaYaga.sln runs it. -->
    <Compile Include="..\..\tests\SkeletonDataTests.cs" Link="tests\SkeletonDataTests.cs" />
    <Compile Include="..\..\tests\BeltPotionTests.cs" Link="tests\BeltPotionTests.cs" />
    <Compile Include="..\..\tests\BeltDeathTests.cs" Link="tests\BeltDeathTests.cs" />
    <Compile Include="..\..\tests\BeltCastTests.cs" Link="tests\BeltCastTests.cs" />
    <Compile Include="..\..\tests\BeltQuestTests.cs" Link="tests\BeltQuestTests.cs" />
    <Compile Include="..\..\tests\WalkTravelTests.cs" Link="tests\WalkTravelTests.cs" />
    <Compile Include="..\..\tests\BeltRegenTests.cs" Link="tests\BeltRegenTests.cs" />
    <Compile Include="..\..\tests\HirelingTests.cs" Link="tests\HirelingTests.cs" />
    <Compile Include="..\..\tests\BeltStashTests.cs" Link="tests\BeltStashTests.cs" />
    <Compile Include="..\..\tests\CliVerbsTests.cs" Link="tests\CliVerbsTests.cs" />
    <Compile Include="..\..\tests\CliTwinVerbsTests.cs" Link="tests\CliTwinVerbsTests.cs" />
    <Compile Include="..\..\tests\HirelingDeathTests.cs" Link="tests\HirelingDeathTests.cs" />
    <Compile Include="..\..\tests\HirelingGearTests.cs" Link="tests\HirelingGearTests.cs" />
    <Compile Include="..\..\tests\HirelingStatTests.cs" Link="tests\HirelingStatTests.cs" />
    <!-- M5-S3 sim bridge (MC 11934): the test rides the same link idiom; it
         exercises the two PURE bridge files under game/scripts (no Godot types). -->
    <Compile Include="..\..\tests\GameBridgeTests.cs" Link="tests\GameBridgeTests.cs" />
    <!-- The bridge files under test: PURE by design (the S3 design note), so
         they compile in beside the tests; the Godot glue stays outside. -->
    <Compile Include="..\..\game\scripts\SessionClock.cs" Link="game\SessionClock.cs" />
    <Compile Include="..\..\game\scripts\CommandLog.cs" Link="game\CommandLog.cs" />
    <!-- M5-S4 render+input (MC 11937): same idiom — the decision cores the S4
         input map rides are PURE (no Godot types), so they compile in beside
         the tests; the scene glue stays outside. -->
    <Compile Include="..\..\tests\GameInputTests.cs" Link="tests\GameInputTests.cs" />
    <Compile Include="..\..\game\scripts\ClickMap.cs" Link="game\ClickMap.cs" />
    <Compile Include="..\..\game\scripts\SpriteRoster.cs" Link="game\SpriteRoster.cs" />
    <Compile Include="..\..\game\scripts\DeathMenuLogic.cs" Link="game\DeathMenuLogic.cs" />
    <!-- M5-S6 town panel (MC 11940): same idiom — the mapping/gate core the
         TownPanel rides is PURE (no Godot types), the widget glue stays outside. -->
    <Compile Include="..\..\tests\TownPanelTests.cs" Link="tests\TownPanelTests.cs" />
    <Compile Include="..\..\game\scripts\TownPanelLogic.cs" Link="game\TownPanelLogic.cs" />
    <!-- M5-S5 HUD read-backs (MC 11939): the HUDCORE define (PropertyGroup)
         compiles the pure HudReadout half of Hud.cs in beside the tests; the
         Godot shell of the same file stays engine-side (file header). -->
    <Compile Include="..\..\tests\HudReadoutTests.cs" Link="tests\HudReadoutTests.cs" />
    <Compile Include="..\..\game\scripts\Hud.cs" Link="game\Hud.cs" />
    <!-- M5 FIX-back (MC 11943): the D2 cell-re-derivation core extracted from
         InventoryPanel is PURE (no Godot types), same link idiom; the test
         also carries the shipped-file scan rows for the D1/D3 fix shapes. -->
    <Compile Include="..\..\tests\M5GateFixTests.cs" Link="tests\M5GateFixTests.cs" />
    <Compile Include="..\..\game\scripts\InventoryPanelLogic.cs" Link="game\InventoryPanelLogic.cs" />
    <!-- ARCH-closing rows 5+1 (MC 11949): the mana item-term wire tests and the
         per-class start pins — new files under tests/, same link idiom. -->
    <Compile Include="..\..\tests\ManaItemTermTests.cs" Link="tests\ManaItemTermTests.cs" />
    <Compile Include="..\..\tests\ClassStartTests.cs" Link="tests\ClassStartTests.cs" />
    <!-- ARCH row 4 (MC 11950): the hero worn-life/+Vit item-term tests — the
         mana idiom mirrored on the life twin; same link idiom. -->
    <Compile Include="..\..\tests\LifeItemTermTests.cs" Link="tests\LifeItemTermTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BabaYaga.Sim\BabaYaga.Sim.csproj" />
    <ProjectReference Include="..\BabaYaga.Sim.Cli\BabaYaga.Sim.Cli.csproj" />
  </ItemGroup>

</Project>
